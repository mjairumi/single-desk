{
  "manifest_version": 3,
  "name": "Signal Desk",
  "version": "0.1.0",
  "description": "Save, sync and triage links, reading list, and tab sessions — with two-way Chrome bookmark sync.",
  "permissions": ["bookmarks", "tabs", "tabGroups", "storage", "alarms"],
  "host_permissions": [
    "https://signal-desk.darkrumi.in/*",
    "https://signal-desk-api-h6fn.onrender.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Signal Desk" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
