# Template for LOCAL development. Copy to `.env` (which git ignores) and fill in.
#   cp .env.example .env
#
# Production (Neon) config belongs in the deployed host's environment, or in an
# untracked `.env.production` for running migrations from your laptop.
# Full walkthrough: docs/LOCAL_SETUP.md

# QUOTE THE VALUES. A connection string can contain `&` (Neon's does), and an
# unquoted `&` will break `set -a && . ./.env`.

# Local Postgres. app/config.py normalizes the scheme to postgresql+psycopg://.
DATABASE_URL="postgresql://signaldesk:signaldesk@localhost:5432/signaldesk"

# Signs access JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="dev-insecure-change-me-please"

ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"

# Comma-separated allowed CORS origins. The web app is served same-origin by
# FastAPI and needs no entry; add your extension id once you load it unpacked.
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Interactive API docs at /docs, /redoc, /openapi.json.
# Defaults to OFF in code so a public deploy never exposes the API surface;
# turn it on for local development only.
ENABLE_DOCS="true"
